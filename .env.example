# Service Ports (Host mappings)
API_PORT=8000
MLFLOW_PORT=5050
GRAFANA_PORT=3030
PROMETHEUS_PORT=9090

# Telemetry DB & Storage Paths
DATAPULSE_DATA_PATH=/volume2/docker/auto-datapulse/data
TELEMETRY_DB_PATH=/data/auto-datapulse/telemetry.duckdb
MODEL_DIR=/data/homelab-mlops/models
FEATURE_OUTPUT_DIR=/data/homelab-mlops/features

# GitHub Automated Alerts & Metric Commits
GITHUB_TOKEN=ghp_your_token_here
GITHUB_REPO=siddharthsbhadauria/homelab-mlops

# Scheduling & Model Hyperparameters
POLL_INTERVAL_SECONDS=900
PIPELINE_INTERVAL_SECONDS=21600
CONTAMINATION=0.05
